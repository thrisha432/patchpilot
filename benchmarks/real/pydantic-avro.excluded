package = "pydantic_avro"
pythonpath = "/work/src"
v1_requirements = "pydantic==1.10.27 pytest==8.4.2 pytest-mock==3.14.0 fastavro==1.9.7 avro==1.11.3"
v2_requirements = "pydantic==2.14.2 pydantic-settings==2.16.2 pytest==8.4.2 pytest-mock==3.14.0 fastavro==1.9.7 avro==1.11.3"
# Score against the maintainers post-migration test suite (SWE-bench style; never shown to systems).
target_tests = "migration"
