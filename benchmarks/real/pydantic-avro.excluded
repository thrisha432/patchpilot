id = "real-pydantic-avro"
title = "pydantic-avro: generate Avro schemas from Pydantic models"
repo = "https://github.com/godatadriven/pydantic-avro"
license = "MIT"
base = "e12f665c8cb0c7a796ebab53a9e2fb22cebf5fe0"
