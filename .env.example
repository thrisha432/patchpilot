# Copy to .env (git-ignored) and fill in. Never commit the real key.
# Free key: https://aistudio.google.com/apikey  (free tier; data may be used by Google,
# so only run PatchPilot on public or sample code with it)
GEMINI_API_KEY=

# Directories the HTTP API may read repositories from (colon-separated).
# Defaults to the current working directory.
# PATCHPILOT_ALLOWED_ROOTS=/path/to/repos
